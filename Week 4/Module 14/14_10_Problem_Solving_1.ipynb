    "import pandas as pd\n",
    "\n",
    "def delete_duplicate_emails(person: pd.DataFrame) -> None:\n",
    "\n",
    "    person.sort_values('id',inplace=True)\n",
    "    person.drop_duplicates(subset=['email'],inplace = True)\n"
   ]
  }
