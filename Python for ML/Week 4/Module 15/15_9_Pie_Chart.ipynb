    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as pl\n",
    "\n",
    "df = pd.read_csv('student_data (1).csv')\n",
    "df\n",
    "\n",
    "status = df.groupby('CompletionStatus').size()\n",
    "\n",
    "pl.pie(status,labels=status.index ,autopct='%1.1f%%',explode=[0.05,0,0],shadow=True)\n",
    "pl.show()"
   ]
  }
