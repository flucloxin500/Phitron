   "source": [
    "import numpy as np\n",
    "\n",
    "def matrix_dot_vector(a: list[list[int|float]], b: list[int|float]) -> list[int|float]:\n",
    "    \n",
    "    a = np.array(a)\n",
    "    b = np.array(b)\n",
    "    \n",
    "    shape_a = a.shape\n",
    "    \n",
    "    if shape_a[1] != b.size :\n",
    "        return -1\n",
    "    \n",
    "    dot = np.dot(a, b).tolist()\n",
    "    return dot"
   ]
  }
 ],
