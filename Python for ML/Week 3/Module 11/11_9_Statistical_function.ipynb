   "source": [
    "import numpy as np\n",
    "\n",
    "study_hours = np.array([1, 2, 3, 4, 5])\n",
    "exam_scores = np.array([50, 55, 65, 70, 75])\n",
    "\n",
    "data = np.array([study_hours, exam_scores])\n",
    "\n",
    "correlation = np.corrcoef(data)\n",
    "print(\"Correlation matrix:\\n\", correlation)"
   ]
  }
