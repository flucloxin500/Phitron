   ],
   "source": [
    "def safe_divide(a,b):\n",
    "    \n",
    "    try:\n",
    "        result = a/b\n",
    "    except ZeroDivisionError:\n",
    "        print(\"Division by Zero\")\n",
    "    else:\n",
    "        print(f\"The result is: {result}\")\n",
    "   \n",
    "\n",
    "x = int(input())\n",
    "y = int(input())\n",
    "\n",
    "safe_divide(x,y)\n"
   ]
  }
